# ==============================================================================
# Chethan Kumar Portfolio Environment Variables Template
# Safe placeholder values only — NEVER commit populated .env files to source control.
# Distinguish LOCAL DEVELOPMENT settings from PRODUCTION SECRETS in hosting vaults
# (Vercel / Railway encrypted environment variable stores).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE BUILD VARIABLES (Publicly bundled by Vite — NO secrets!)
# ------------------------------------------------------------------------------
# Optional API base URL when frontend is served separately from the Node.js API.
# Leave unset when using same-origin /api/* rewrites on Vercel.
# VITE_API_BASE_URL=https://your-backend.example.com
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_spa_client_id

# ------------------------------------------------------------------------------
# 2. REQUIRED PRODUCTION SECURITY SECRETS (Fail-Closed in NODE_ENV=production)
# ------------------------------------------------------------------------------
# Generate cryptographically random secrets per environment (e.g. `openssl rand -hex 32`).
# Placeholder, weak, or short values are rejected at startup in production.
NODE_ENV=development
PORT=3001
ADMIN_PASSWORD=local-dev-only-change-before-production-use
SECURITY_HMAC_KEY=local-dev-only-hmac-key-replace-with-32-random-bytes

# Comma-separated explicit origin allowlist for credentialed cross-origin API requests.
# NEVER include http://localhost:* origins in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Backend Auth0 OIDC/JWKS Verification (must match Auth0 tenant issuer & audience)
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Optional file paths for local/fallback persistence JSON stores
# STATE_FILE_PATH=server/security-state.json
# NOTIFICATIONS_LOG_PATH=server/notifications-log.json

# ------------------------------------------------------------------------------
# 3. GITHUB REPOSITORY SYNCHRONIZATION (Optional higher rate-limit PAT)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=your_github_token_optional

# ------------------------------------------------------------------------------
# 4. TWILIO & NOTIFICATION PROVIDERS (Optional Multi-Channel Alerts)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_ACCOUNT_EMAIL=security@example.com
TWILIO_TRIAL_MODE=true

# Twilio Programmable SMS
TWILIO_FROM_NUMBER=+15005550006
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OWNER_ALERT_PHONE_E164=+15550000000
TWILIO_VERIFIED_RECIPIENT_PHONE=+15550000000
TWILIO_SMS_STATUS_CALLBACK_URL=https://your-backend.example.com/api/webhooks/twilio/sms
TWILIO_STATUS_CALLBACK_URL=https://your-backend.example.com/api/webhooks/twilio/status
PHONE_OWNERSHIP_VERIFIED=false

# Email Notification Provider ("twilio" | "resend" | "smtp")
EMAIL_PROVIDER=twilio
EMAIL_FROM_ADDRESS=security@example.com
TWILIO_EMAIL_FROM_ADDRESS=security@example.com
OWNER_ALERT_EMAIL=owner@example.com
TWILIO_EMAIL_API_BASE_URL=https://comms.twilio.com/v1/Emails
TWILIO_EMAIL_DOMAIN_VERIFIED=false

# Twilio / Meta WhatsApp Notifications
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
OWNER_WHATSAPP_PHONE_E164=+15550000000
TWILIO_WHATSAPP_STATUS_CALLBACK_URL=https://your-backend.example.com/api/webhooks/twilio/whatsapp
TWILIO_WHATSAPP_SANDBOX_JOINED=false
WHATSAPP_OWNERSHIP_VERIFIED=false
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_with_random_whatsapp_verify_token

# Optional Secondary Email Providers
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_DOMAIN_VERIFIED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password
SMTP_SECURE=false

# ------------------------------------------------------------------------------
# 5. FIREBASE FIRESTORE ADMIN PERSISTENCE (Optional Serverless State Store)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
