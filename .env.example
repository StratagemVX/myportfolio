# ==============================================================================
# Chethan Kumar Portfolio Environment Variables Specification & Template
# Safe template containing placeholder values only. Never commit real secrets.
# ==============================================================================

# Core Identity (Client-safe — Publicly bundled into browser)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_client_id_placeholder
VITE_AUTH0_AUDIENCE=https://api.chethankumar.dev
VITE_PORTFOLIO_ENV=development

# Server Internal Security Secrets
SECURITY_HMAC_KEY=your_secure_random_hmac_seed_key_replace_in_production
GITHUB_TOKEN=your_github_personal_access_token_optional

# ==============================================================================
# TWILIO UNIFIED NOTIFICATION INFRASTRUCTURE
# ==============================================================================

# Twilio Core Credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_TRIAL_MODE=true

# Twilio Programmable SMS
SMS_PROVIDER=twilio
TWILIO_FROM_NUMBER=+15005550006
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OWNER_ALERT_PHONE_E164=+1234567890
TWILIO_SMS_STATUS_CALLBACK_URL=https://api.chethankumar.dev/api/webhooks/twilio/sms
TWILIO_VERIFIED_RECIPIENT_PHONE=+1234567890
PHONE_OWNERSHIP_VERIFIED=false

# Twilio Comms Email API (Primary Transactional Email)
EMAIL_PROVIDER=twilio
TWILIO_EMAIL_FROM_ADDRESS=security@chethankumar.dev
OWNER_ALERT_EMAIL=owner@example.com
TWILIO_EMAIL_API_BASE_URL=https://comms.twilio.com/v1/Emails
TWILIO_EMAIL_WEBHOOK_URL=https://api.chethankumar.dev/api/webhooks/twilio/email
TWILIO_EMAIL_DOMAIN_VERIFIED=false

# Twilio WhatsApp Messaging (Sandbox / Registered Sender)
WHATSAPP_PROVIDER=twilio
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
OWNER_WHATSAPP_PHONE_E164=+1234567890
TWILIO_WHATSAPP_STATUS_CALLBACK_URL=https://api.chethankumar.dev/api/webhooks/twilio/whatsapp
TWILIO_WHATSAPP_SANDBOX_JOINED=false
WHATSAPP_OWNERSHIP_VERIFIED=false

# Alternative / Secondary Email Providers (Optional)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_DOMAIN_VERIFIED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password
SMTP_SECURE=false

# ==============================================================================
# FIREBASE FIRESTORE & CLOUD MESSAGING (FCM)
# Spark Plan / Free Tier: 50,000 document reads, 20,000 document writes / day
# ==============================================================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
VITE_FIREBASE_API_KEY=AIzaSyPlaceholderKeyForClientApp
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_VAPID_KEY=your_fcm_vapid_public_key_here

# ==============================================================================
# DEPLOYMENT CONFIGURATION (Railway / Vercel)
# ==============================================================================
PORT=3001
CORS_ORIGIN=https://chethankumar.dev
CORS_ALLOWED_ORIGINS=https://chethankumar.dev,https://chethan-kumar-portfolio.vercel.app
ADMIN_PASSWORD=your_secure_admin_password_here
